<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="isAdmin" value="${sessionScope.userRole eq 'ADMIN'}" />
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'QuizDesk' : pageTitle}" /> &middot; QuizDesk</title>
    <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<body>

<header class="navbar">
    <div class="wrap">
        <a class="brand" href="${ctx}${isAdmin ? '/admin/dashboard' : '/dashboard'}">
            <span class="brand-mark">Q</span>
            <span>QuizDesk</span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Toggle navigation">&#9776;</button>

        <nav class="nav-links" aria-label="Main navigation">
            <c:choose>
                <c:when test="${isAdmin}">
                    <a href="${ctx}/admin/dashboard" class="${pageTitle eq 'Admin dashboard' ? 'active' : ''}">Dashboard</a>
                    <a href="${ctx}/admin/quizzes" class="${fn:contains(pageTitle, 'quizzes') or fn:contains(pageTitle, 'quiz') ? 'active' : ''}">Quizzes</a>
                    <a href="${ctx}/admin/users" class="${pageTitle eq 'Users' ? 'active' : ''}">Users</a>
                    <a href="${ctx}/admin/results" class="${pageTitle eq 'Results' ? 'active' : ''}">Results</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/dashboard" class="${pageTitle eq 'Dashboard' ? 'active' : ''}">Dashboard</a>
                    <a href="${ctx}/quizzes" class="${fn:contains(pageTitle, 'Quiz') ? 'active' : ''}">Quizzes</a>
                    <a href="${ctx}/results" class="${fn:contains(pageTitle, 'results') or fn:contains(pageTitle, 'Result') ? 'active' : ''}">My Results</a>
                    <a href="${ctx}/profile" class="${pageTitle eq 'Profile' ? 'active' : ''}">Profile</a>
                </c:otherwise>
            </c:choose>
        </nav>

        <div class="nav-user">
            <span class="avatar" aria-hidden="true">
                <c:out value="${fn:substring(sessionScope.userName, 0, 1)}" />
            </span>
            <span class="small muted nowrap">
                <c:out value="${sessionScope.userName}" />
                <c:if test="${isAdmin}"> &middot; Admin</c:if>
            </span>
            <form method="post" action="${ctx}/logout" class="mb-0">
                <button class="btn btn-secondary btn-sm" type="submit">Sign out</button>
            </form>
        </div>
    </div>
</header>

<c:set var="flashSuccess" value="${sessionScope.flashSuccess}" />
<c:set var="flashError" value="${sessionScope.flashError}" />
<c:remove var="flashSuccess" scope="session" />
<c:remove var="flashError" scope="session" />
