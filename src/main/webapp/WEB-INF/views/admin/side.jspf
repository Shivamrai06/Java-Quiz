<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<nav class="admin-side" aria-label="Admin navigation">
    <div class="side-title">Administration</div>
    <a href="${ctx}/admin/dashboard" class="${pageTitle eq 'Admin dashboard' ? 'active' : ''}">Dashboard</a>
    <a href="${ctx}/admin/quizzes" class="${fn:contains(pageTitle, 'quizzes') or fn:contains(pageTitle, 'quiz') ? 'active' : ''}">Quizzes</a>
    <a href="${ctx}/admin/users" class="${pageTitle eq 'Users' ? 'active' : ''}">Users</a>
    <a href="${ctx}/admin/results" class="${pageTitle eq 'Results' ? 'active' : ''}">Results</a>

    <div class="side-title" style="margin-top:8px;">Student view</div>
    <a href="${ctx}/quizzes">Browse as student</a>
</nav>
